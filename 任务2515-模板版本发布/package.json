{
  "name": "template-version-release",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SOP template version release, disable and instance version isolation. React 18 + Vite 6 + Express mock + Playwright.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "mock": "node mock-server/index.js",
    "dev:all": "concurrently -k \"npm:mock\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:unit": "node --test tests/version.test.js",
    "test:e2e": "playwright test tests/flow.spec.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  },
  "license": "MIT"
}
